   typeCheckCategory

	| typeChecker |

	selectedSystemCategory ifNotNil: [
		typeChecker := ManyMethodsTypeChecker forAllClasses: (systemOrganizer allClassesAt: selectedSystemCategory).
		typeChecker value.
		typeChecker showResultsWith: selectedSystemCategory name ]

	! !
