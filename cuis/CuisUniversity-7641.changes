								'do: [:argm1_5 | temp3 := arg2 value: temp3 value: argm1_5]'
								'value: temp3 value: argm1_5'
								':= arg2 value: temp3 value: argm1_5'
								'temp3 := arg2 value: temp3 value: argm1_5'
								'value: temp3 value: argm1_5'
								':= arg2 value: temp3 value: argm1_5'
								'temp3 := arg2 value: temp3 value: argm1_5'
								'^temp3')! !
