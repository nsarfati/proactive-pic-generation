          browse
	
	catalog browse: result! !
!CompositeCatalogResult methodsFor: 'initialization' stamp: 'NPM 4/20/2020 16:54:28'!
      initializeWith: aResult from: aCatalog

	catalog := aCatalog.
	result := aResult.! !
