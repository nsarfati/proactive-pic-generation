!DepthTest class methodsFor: 'measure - runner' stamp: 'NMS 2/12/2026 17:03:17'!
       runTestWriteResultsTo: aCSVFile for: aBlock

	| picFlow line time |

	picFlow := aCSVFile asFileEntry.
	time := aBlock value.

	line := 'd1', ',', picEntries asString, ',', time asString, String lfString.
	picFlow appendContents: line.! !
!DepthTest class methodsFor: 'measure' stamp: 'NMS 2/10/2026 18:59:48'!
         calculateTookTime
	measureUnit = 'msNoGc' ifTrue: [
		^[self d1] millisecondsToRunWithoutGC.
	] ifFalse: [
		measureUnit = 'ms' ifTrue: [
			^[self d1] millisecondsToRun.
		] ifFalse: [
			^[self d1] microsecondsToRun.
		]
	]! !
!DepthTest class methodsFor: 'measure' stamp: 'NMS 2/13/2026 17:13:43'!
                   gcCollect
	gcDesiredTimesToRun timesRepeat: [
		Smalltalk garbageCollect
	]
! !
!DepthTest class methodsFor: 'measure' stamp: 'NMS 1/10/2026 21:57:02'!
        gcParameter
	^9! !
!DepthTest class methodsFor: 'measure' stamp: 'NMS 2/13/2026 17:13:43'!
     measureWithJITFlow

	| receivers receivers2 |

	receivers := self getTestCaseReceivers.
	receivers2 := self getTestCaseReceivers2.

	receivers2 do: [ :r |
		r class recompile: #d4.
		r class recompile: #d3.
		r class recompile: #d2.
	].

	self class recompile: #d4.
	self class recompile: #d3.
	self class recompile: #d2.
	self class recompile: #d1.

	self gcCollect.

	PICManager jit: DepthTest class>>#d1 withSelector: #d1.
	PICManager jit: DepthTest class>>#d2 withSelector: #d2.
	PICManager jit: DepthTest class>>#d3 withSelector: #d3.
	PICManager jit: DepthTest class>>#d4 withSelector: #d4.

	PICManager jit: DepthTest2 class>>#d2 withSelector: #d2.
	PICManager jit: DepthTest2 class>>#d3 withSelector: #d3.
	PICManager jit: DepthTest2 class>>#d4 withSelector: #d4.

	PICManager jit: DepthTest3 class>>#d2 withSelector: #d2.
	PICManager jit: DepthTest3 class>>#d3 withSelector: #d3.
	PICManager jit: DepthTest3 class>>#d4 withSelector: #d4.

	PICManager jit: DepthTest4 class>>#d2 withSelector: #d2.
	PICManager jit: DepthTest4 class>>#d3 withSelector: #d3.
	PICManager jit: DepthTest4 class>>#d4 withSelector: #d4.

	PICManager jit: DepthTest5 class>>#d2 withSelector: #d2.
	PICManager jit: DepthTest5 class>>#d3 withSelector: #d3.
	PICManager jit: DepthTest5 class>>#d4 withSelector: #d4.

	PICManager jit: DepthTest6 class>>#d2 withSelector: #d2.
	PICManager jit: DepthTest6 class>>#d3 withSelector: #d3.
	PICManager jit: DepthTest6 class>>#d4 withSelector: #d4.

	^ self runAndMeasure: 'measureWithJITFlow' forReceiver1: receivers andReceivers2: receivers2 executeInEach: [:gcTimes | gcTimes].! !
!DepthTest class methodsFor: 'measure' stamp: 'NMS 2/13/2026 17:13:43'!
                 measureWithNormalFlowCurrentBehaviour

	| receivers receivers2 |

	receivers := self getTestCaseReceivers.
	receivers2 := self getTestCaseReceivers2.

	receivers2 do: [ :r |
		r class recompile: #d4.
		r class recompile: #d3.
		r class recompile: #d2.
	].

	self class recompile: #d4.
	self class recompile: #d3.
	self class recompile: #d2.
	self class recompile: #d1.

	self gcCollect.
	
	^ self runAndMeasure: 'measureWithNormalFlowCurrentBehaviour' forReceiver1: receivers andReceivers2: receivers2 executeInEach: [:gcTimes | gcTimes].! !
!DepthTest class methodsFor: 'measure' stamp: 'NMS 2/13/2026 17:13:43'!
                          measureWithNormalFlowWorstCase

	| receivers receivers2 |

	receivers := self getTestCaseReceivers.
	receivers2 := self getTestCaseReceivers2.

	self gcCollect.
	
	^ self runAndMeasure: 'measureWithNormalFlowWorstCase' forReceiver1: receivers andReceivers2: receivers2 executeInEach: [ :gcTimes |

		receivers2 do: [ :r |
			r class recompile: #d4.
			r class recompile: #d3.
			r class recompile: #d2.
		].

		self class recompile: #d4.
		self class recompile: #d3.
		self class recompile: #d2.
		self class recompile: #d1.

		Smalltalk vmParameterAt: self gcParameter.
	].! !
!DepthTest class methodsFor: 'measure' stamp: 'NMS 2/13/2026 17:13:43'!
                      measureWithPIC

	| receivers receivers2 |

	receivers := self getTestCaseReceivers.
	receivers2 := self getTestCaseReceivers2.

	receivers2 do: [ :r |
		r class recompile: #d4.
		r class recompile: #d3.
		r class recompile: #d2.
	].

	self class recompile: #d4.
	self class recompile: #d3.
	self class recompile: #d2.
	self class recompile: #d1.

	self gcCollect.

	self picD1.
	self picD2.
	self picD3.
	self picD4.

	self generatePICForDepthTest2.
	self generatePICForDepthTest3.
	self generatePICForDepthTest4.
	self generatePICForDepthTest5.
	self generatePICForDepthTest6.
	
	^ self runAndMeasure: 'measureWithPIC' forReceiver1: receivers andReceivers2: receivers2 executeInEach: [:gcTimes | gcTimes].! !
!DepthTest class methodsFor: 'measure' stamp: 'NMS 2/13/2026 17:14:25'!
                  runAndMeasure: flow forReceiver1: receivers andReceivers2: receivers2 executeInEach: aBlock 

	| gcTimes effectiveBatches batchOk total took batchTotal |

	gcTimes := Smalltalk vmParameterAt: self gcParameter.
	effectiveBatches := 0.
	total := 0.

	[ effectiveBatches < timesToIterate ] whileTrue: [
		gcTimes := aBlock value: gcTimes.
		batchOk := true.
		batchTotal := 0.

		(1 to: picEntries) do: [:picEntry |
			receiver := receivers at: picEntry.
			receiver2 := receivers2 at: picEntry.

			took := self calculateTookTime.

			(gcTimes = (Smalltalk vmParameterAt: self gcParameter)) ifTrue: [
				batchTotal := batchTotal + took.
			] ifFalse: [
				StdIOWriteStream
					stderr
					nextPutAll: 'On: ', flow, ' original gcTimes !!= current gcTimes';
					newLine.

				batchOk := false.
				gcMatched := false.
				self gcCollect.
				gcTimes := Smalltalk vmParameterAt: self gcParameter.	
			]
		].

		batchOk ifTrue: [
			total := total + batchTotal.
			effectiveBatches := effectiveBatches + 1
		].
	].

	^total! !
!DepthTest class methodsFor: 'initialization' stamp: 'NMS 10/31/2025 11:38:41'!
               getTestCaseReceivers

	| receivers arr oc str heap interv set |

	oc := OrderedCollection new.
	arr := Array new: 100.
	str := ''.
	heap := Heap new.
	interv := 1 to: 100.
	set := Set new.

	"Just add some values in order to get more content in size"
	(1 to: 100) do: [ :i |
		oc add: i.
		arr at: i put: i asString.
		str := str, i asString.
		heap add: i asString.
		set add: i asString.
	].

	"Now receivers could be 6, all entries of a PIC"
	receivers := OrderedCollection with: oc with: arr with: str with: heap with: interv with: set.

	"Now livetyping knows which type is each"
	receivers do: [ :aColl |
		receiver := aColl.
	].

	^ receivers! !
!DepthTest class methodsFor: 'initialization' stamp: 'NMS 10/31/2025 14:03:11'!
   getTestCaseReceivers2

	| receivers2 |

	"Now receivers could be 6, all entries of a PIC"
	receivers2 := OrderedCollection with: DepthTest with: DepthTest2 with: DepthTest3 with: DepthTest4 with: DepthTest5 with: DepthTest6.

	"Now livetyping knows which type is each"
	receivers2 do: [ :aColl |
		receiver2 := aColl.
	].

	^ receivers2! !
!DepthTest class methodsFor: 'initialization' stamp: 'NMS 2/12/2026 12:39:10'!
                             initializeWithPicEntries: aPicEntries iterate: aTimesToIterate gcTimes: aGcDesiredTimesToRun saveItAsIterationName: aRunName withMeasureUnit: aMeasureUnit andSetSize: aSetSize  

	| lines |

	picEntries := aPicEntries.
	timesToIterate := aTimesToIterate.
	gcDesiredTimesToRun := aGcDesiredTimesToRun.
	runName := aRunName.
	gcMatched := true.
	measureUnit := aMeasureUnit.
	setSize := aSetSize.

	lines := self readLinesForTestFile: 'depthtest.txt'.

	iter1 := (lines at: 1) asNumber.
	iter2 := (lines at: 2) asNumber.
	iter3 := (lines at: 3) asNumber.
	iter4 := (lines at: 4) asNumber.
! !
!DepthTest class methodsFor: 'initialization' stamp: 'NMS 2/12/2026 12:39:10'!
  readLinesForTestFile: aTestFile
