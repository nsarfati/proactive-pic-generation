    denyComputingEntriesIsSupportedWhenBrowsing: sourceCode 
	
	| completer |
	completer := self createCompleterForBrowsing: sourceCode.
	
	self
		should: [ completer computeEntries ]
		raise: Error.
	self
		assert: completer
