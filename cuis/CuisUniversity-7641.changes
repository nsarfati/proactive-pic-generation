!DepthPICBenchmark class methodsFor: 'as yet unclassified' stamp: 'NMS 6/11/2026 12:38:33' prior: 50609038!
                      measureWithPIC

	| compiledMethod |

	compiledMethod := sender class >> stressedMethod asSymbol.
	(compiledMethod methodClass) recompile: (compiledMethod selector).

	self gcCollect.
	self updateMaxVMStats: initializationVMStats.
	ProactivePICBuilder generatePICFor: compiledMethod.

	^ self runAndMeasure: compiledMethod in: 'measureWithPIC' executeInEach: [:gcTimes | gcTimes].! !
!ProactivePICBuilder class methodsFor: 'as yet unclassified' stamp: 'NMS 6/11/2026 12:38:33' prior: 50596282!
                   generatePICFor: aCompiledMethod
	| pc client iStream res receiver |

	client := SendRecorderClient on: aCompiledMethod.
	iStream := InstructionStream on: aCompiledMethod.

	[ iStream atEnd ] whileFalse: [
		
		pc := (iStream willSend)
				ifTrue: [ iStream followingPc - 1 ] "last byte of current instruction"
				ifFalse: [ nil ].

		receiver := iStream interpretNextInstructionFor: client.

		(pc notNil) ifTrue: [

			(receiver key = #NotInterested) ifFalse: [
				| tags methodsToPIC |				

				tags := (aCompiledMethod methodClass instanceVariablesTypes typeInfoOf: (receiver key)) types asArray.

				methodsToPIC := (tags collect: [ :each |
					each lookupSelector: (receiver value) 
				]).

				(methodsToPIC notEmpty) ifTrue: [
					res := ProactivePICBuilder
							handleCompiledMethods: methodsToPIC
							forClasses: tags
							withSelector: receiver value
							patchMethod: aCompiledMethod
							withSelector: aCompiledMethod selector
							atSendReturnPCs: {pc}.

"
					Transcript
						show: 'PICManager handleCompiledMethods: ', methodsToPIC printString; cr;
						show: '    forClasses: ', tags printString; cr;
						show: '    withSelector: ', receiver value printString; cr;
						show: '    patchMethod: ', aCompiledMethod printString; cr;
						show: '    withSelector: ', aCompiledMethod selector printString; cr;
						show: '    atSendReturnPCs: ', { pc } printString; cr; cr.
"					
				]
			]
		]
  	].

	^res
! !
!PerformanceTest class methodsFor: 'as yet unclassified' stamp: 'NMS 6/11/2026 12:38:33' prior: 50607835!
           measureWithJIT

	| receivers compiledMethod |

	receivers := self getTestCaseReceivers.
	compiledMethod := self class >> stressedMethod asSymbol.
	(compiledMethod methodClass) recompile: (compiledMethod selector).

	self gcCollect.
	self updateMaxVMStats: initializationVMStats.
	ProactivePICBuilder jit: compiledMethod withSelector: compiledMethod selector.

	^ self runAndMeasure: compiledMethod in: 'measureWithJITFlow' forReceivers: receivers executeInEach: [:gcTimes | gcTimes].! !
