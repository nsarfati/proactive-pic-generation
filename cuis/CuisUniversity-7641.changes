!Transcript class methodsFor: 'private' stamp: 'jmv 6/30/2025 09:11:45' prior: 50337409!
                         displayEngine
	"See
		#display
		#displayUnfinishedEntry
		#displayEngine"
	"
	Transcript releaseClassCachedState
	"
	| deferredDisplay |
