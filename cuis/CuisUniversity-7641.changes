!DepthTest class methodsFor: 'measure - runner' stamp: 'NMS 2/12/2026 17:02:23'!
                  runPerformanceTestForDepthJITFlow  

	DepthTest2 initialize.
	DepthTest3 initialize.
	DepthTest4 initialize.
	DepthTest5 initialize.
	DepthTest6 initialize.

	self runTestWriteResultsTo: 'depth/', runName, '/results_jit_flow.csv' for: [
		self measureWithJITFlow
	].

	gcMatched ifTrue: [
		Smalltalk quitPrimitive: 0.
	] ifFalse: [
		Smalltalk quitPrimitive: 1.
	]! !
