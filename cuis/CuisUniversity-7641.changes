!Layout methodsFor: 'testing' stamp: 'jmv 7/3/2025 15:51:04'!
             isLinearLayout
	^false! !
!LinearLayout methodsFor: 'testing' stamp: 'jmv 7/3/2025 15:50:56' overrides: 50341915!
