!methodRemoval: Behavior #removeAllObsoleteSubclasses stamp: 'Install-7258-ObsoleteClasses-simplify-JuanVuletich-2025Jun02-14h26m-jmv.001.cs.st 7/15/2025 11:02:08'!
removeAllObsoleteSubclasses
