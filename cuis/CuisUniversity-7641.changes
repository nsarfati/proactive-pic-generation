                       initializeMenues

	BrowserWindow registerAll: self browserWindowMenuSpecs.
	MethodSetWindow registerAll: self methodSetWindowMenuSpecs.
	DebuggerWindow registerAll: self debuggerWindowMenuSpecs.
	! !
