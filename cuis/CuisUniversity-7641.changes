!PerformanceTest class methodsFor: 'measure - runner' stamp: 'NMS 2/13/2026 18:00:53' prior: 50601631!
         runTestWriteResultsTo: aCSVFile for: aBlock

	| picFlow line time |

	picFlow := aCSVFile asFileEntry.
	time := aBlock value.

	line := stressedMethod, ',', picEntries asString, ',', time asString, String lfString.
	picFlow appendContents: line.! !
!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/13/2026 17:44:23' prior: 50601642!
         calculateTookTime: method
	measureUnit = 'msNoGc' ifTrue: [
		^[self executeMethod: method] millisecondsToRunWithoutGC.
	] ifFalse: [
		measureUnit = 'ms' ifTrue: [
			^[self executeMethod: method] millisecondsToRun.
		] ifFalse: [
			^[self executeMethod: method] microsecondsToRun.
		]
	]! !
