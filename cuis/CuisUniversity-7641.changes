	^ (aParameterClass a) + aB + (aParameterClass c)'.
	newSenderCode := 'm1
	self second: 2 parameterClass: (', self parameterClassName, ' newA: 1 c: 3)'.

	refactor := ExtractParameterObject 
		from: classToRefactor >> selector 
		toClassNamed: self parameterClassName 
