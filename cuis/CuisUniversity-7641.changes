	newNameAsSymbol := aNewName asSymbol.
	
	self assert: (Smalltalk at: oldNameAsSymbol ifAbsent: [ nil ]) isNil.
	self assert: (Smalltalk at: newNameAsSymbol ifAbsent: [ nil ]) isNil.
	
