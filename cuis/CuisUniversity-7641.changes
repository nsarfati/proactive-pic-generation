	k negated moduloTwoPiAsFloat + 1 = 	(k negated+1) moduloTwoPiAsFloat.
	k moduloTwoPiAsFloat + k negated moduloTwoPiAsFloat = Float twoPi.
	(k+1) moduloTwoPiAsFloat + (k negated-1) moduloTwoPiAsFloat = Float twoPi.
	(k-1) moduloTwoPiAsFloat + (k negated+1) moduloTwoPiAsFloat = Float twoPi.
! !
