	^(self includes: anObject) not! !
!DefinedByRules methodsFor: 'querying - excluded' stamp: ''!
            excludesAll: aCollection

	^aCollection allSatisfy: [:each | self excludes: each]! !
!DefinedByRules methodsFor: 'querying - included' stamp: ''!
