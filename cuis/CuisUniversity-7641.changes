"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!

DepthPICBenchmark class
	instanceVariableNames: 'rng sender runName picEntries stressedMethod timesToIterate gcMatched targets'!

!classDefinition: 'DepthPICBenchmark class' category: #'Tesis-DepthTest' stamp: 'NMS 2/21/2026 18:24:12'!
DepthPICBenchmark class
	instanceVariableNames: 'rng sender runName picEntries stressedMethod timesToIterate gcMatched targets'!
!DepthPICBenchmark class methodsFor: 'initialization' stamp: 'NMS 2/21/2026 17:48:57' prior: 50604344!
  initializeWithPicEntries: aPicEntries stressMethod: aStressedMethod iterate: aTimesToIterate saveItAsIterationName: aRunName

	picEntries := aPicEntries.
	stressedMethod := aStressedMethod.
	timesToIterate := aTimesToIterate.
	runName := aRunName.
	gcMatched := true.

	sender := DTSender new.

	targets := {
		DTLeaf1 new.
		DTLeaf2 new.
		DTLeaf3 new.
		DTLeaf4 new.
		DTLeaf5 new.
		DTLeaf6 new
	}.

	"Now livetyping knows which type is each -- until picEntries"
	(1 to: picEntries) do: [ :i |
		sender receiver: (targets at: i)
	].

	rng := Random seed: 666.! !
!DepthPICBenchmark class methodsFor: 'measure - runner' stamp: 'NMS 2/19/2026 13:04:36' prior: 50604365!
 runPerformanceTestJIT

	self runTestWriteResultsTo: runName, '/results_jit_flow.csv' for: [
		self measureWithJIT
	].

	gcMatched ifTrue: [
		Smalltalk quitPrimitive: 0.
	] ifFalse: [
		Smalltalk quitPrimitive: 1.
	]! !
!DepthPICBenchmark class methodsFor: 'measure - runner' stamp: 'NMS 2/18/2026 18:10:18' prior: 50604376!
                           runPerformanceTestNormalFlowCurrentBehaviour

	self runTestWriteResultsTo: runName, '/results_normal_flow_current_behaviour.csv' for: [
		self measureWithNormalFlowCurrentBehaviour
	].

	gcMatched ifTrue: [
		Smalltalk quitPrimitive: 0.
	] ifFalse: [
		Smalltalk quitPrimitive: 1.
	]! !
!DepthPICBenchmark class methodsFor: 'measure - runner' stamp: 'NMS 2/19/2026 13:04:59' prior: 50604389!
                        runPerformanceTestNormalFlowWorstCase

	self runTestWriteResultsTo: runName, '/results_normal_flow_worst_case.csv' for: [
		self measureWithNormalFlowWorstCase
	].

	gcMatched ifTrue: [
		Smalltalk quitPrimitive: 0.
	] ifFalse: [
		Smalltalk quitPrimitive: 1.
	]! !
!DepthPICBenchmark class methodsFor: 'measure - runner' stamp: 'NMS 2/18/2026 18:09:43' prior: 50604401!
             runPerformanceTestPIC 

	self runTestWriteResultsTo: runName, '/results_pic_flow.csv' for: [
		self measureWithPIC
	].

	gcMatched ifTrue: [
		Smalltalk quitPrimitive: 0.
	] ifFalse: [
		Smalltalk quitPrimitive: 1.
	]! !
!DepthPICBenchmark class methodsFor: 'measure - runner' stamp: 'NMS 2/21/2026 18:17:01' prior: 50604412!
                          runTestWriteResultsTo: aCSVFile for: aBlock

	| picFlow line time |

	picFlow := aCSVFile asFileEntry.
	time := aBlock value.

	line := stressedMethod, ',', picEntries asString, ',', time asString, String lfString.
	picFlow appendContents: line.! !
!DepthPICBenchmark class methodsFor: 'measure' stamp: 'NMS 2/18/2026 18:25:16' prior: 50604423!
       calculateTookTime: method
	^[sender executeMethod: method] microsecondsToRun.! !
!DepthPICBenchmark class methodsFor: 'measure' stamp: 'NMS 2/18/2026 18:00:53' prior: 50604429!
               gcCollect
	Smalltalk garbageCollect
! !
!DepthPICBenchmark class methodsFor: 'measure' stamp: 'NMS 2/21/2026 17:53:23' prior: 50604434!
                        measureWithJIT

	| compiledMethod |

	compiledMethod := sender class >> stressedMethod asSymbol.
	(compiledMethod methodClass) recompile: (compiledMethod selector).

	self gcCollect.
	PICManager jit: compiledMethod withSelector: compiledMethod selector.

	^ self runAndMeasure: compiledMethod in: 'measureWithJITFlow' executeInEach: [:gcTimes | gcTimes].! !
!DepthPICBenchmark class methodsFor: 'measure' stamp: 'NMS 2/21/2026 17:53:20' prior: 50604449!
                          measureWithNormalFlowCurrentBehaviour

	| compiledMethod |

	compiledMethod := sender class >> stressedMethod asSymbol.
