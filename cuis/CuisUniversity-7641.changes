	newSourceCode := sourceCode first: start - 1.
	newSourceCode := newSourceCode, aReplacement.
	newSourceCode := newSourceCode, (sourceCode copyFrom: end + 1 to: sourceCode size).
	
	sourceCode := newSourceCode ! !
