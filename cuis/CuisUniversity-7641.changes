!classRenamed: #PICManager as: #ProactivePICBuilder stamp: 'NMS 6/11/2026 12:38:32'!
Smalltalk renameClassNamed: #PICManager as: #ProactivePICBuilder!
!PerformanceTest class methodsFor: 'as yet unclassified' stamp: 'NMS 6/11/2026 12:38:33' prior: 50607888!
         measureWithPIC

	| receivers compiledMethod |

	receivers := self getTestCaseReceivers.
	compiledMethod := self class >> stressedMethod asSymbol.
	(compiledMethod methodClass) recompile: (compiledMethod selector).

	self gcCollect.
	self updateMaxVMStats: initializationVMStats.
	ProactivePICBuilder generatePICFor: compiledMethod.

	^ self runAndMeasure: compiledMethod in: 'measureWithPIC' forReceivers: receivers executeInEach: [:gcTimes | gcTimes].! !
