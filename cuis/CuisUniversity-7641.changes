!DepthTest class methodsFor: 'pic - generation' stamp: 'NMS 2/10/2026 13:05:06'!
                               picD4

	PICManager
		handleCompiledMethods: {
			Integer>>#timesRepeat:
		}
		forClasses: {SmallInteger}
		withSelector: #timesRepeat:
		patchMethod: DepthTest class>>#d4
		withSelector: #d4
		atSendReturnPCs: #(45).

	PICManager
		handleCompiledMethods: {
			OrderedCollection>>#size .
			ArrayedCollection>>#size .
			String>>#size .
			Heap>>#size .
			Interval>>#size .
			Set>>#size
		}
		forClasses: {OrderedCollection . Array . String . Heap . Interval . Set}
		withSelector: #size
		patchMethod: DepthTest class>>#d4
		withSelector: #d4
		atSendReturnPCs: #(43)! !
