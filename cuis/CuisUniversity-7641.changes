  gcParameter
	^ 9! !
!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/13/2026 17:55:30'!
                              measureWithJIT

	| receivers compiledMethod |

	receivers := self getTestCaseReceivers.
	compiledMethod := self class >> stressedMethod asSymbol.
	(compiledMethod methodClass) recompile: (compiledMethod selector).

	self gcCollect.
	PICManager jit: compiledMethod withSelector: compiledMethod selector.

	^ self runAndMeasure: compiledMethod in: 'measureWithJITFlow' forReceivers: receivers executeInEach: [:gcTimes | gcTimes].! !
!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/13/2026 17:55:30'!
   measureWithNormalFlowCurrentBehaviour

	| receivers compiledMethod |

	receivers := self getTestCaseReceivers.
	compiledMethod := self class >> stressedMethod asSymbol.
	(compiledMethod methodClass) recompile: (compiledMethod selector).

	self gcCollect.

	^ self runAndMeasure: compiledMethod in: 'measureWithNormalFlowCurrentBehaviour' forReceivers: receivers executeInEach: [:gcTimes | gcTimes].! !
!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/13/2026 17:58:41'!
measureWithNormalFlowWorstCase

	| receivers compiledMethod |

	receivers := self getTestCaseReceivers.
	compiledMethod := self class >> stressedMethod asSymbol.

	self gcCollect.

	^ self runAndMeasure: compiledMethod in: 'measureWithNormalFlowCurrentBehaviour' forReceivers: receivers executeInEach: [:gcTimes |

		(compiledMethod methodClass) recompile: (compiledMethod selector).
		Smalltalk vmParameterAt: self gcParameter.
	].! !
!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/13/2026 17:55:30'!
                              measureWithPIC

	| receivers compiledMethod |

	receivers := self getTestCaseReceivers.
	compiledMethod := self class >> stressedMethod asSymbol.
	(compiledMethod methodClass) recompile: (compiledMethod selector).

	self gcCollect.
	PICManager generatePICFor: compiledMethod.

	^ self runAndMeasure: compiledMethod in: 'measureWithPIC' forReceivers: receivers executeInEach: [:gcTimes | gcTimes].! !
!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/13/2026 18:00:53'!
  runAndMeasure: aMethod in: flow forReceivers: receivers executeInEach: aBlock 

	| gcTimes effectiveBatches batchOk total took batchTotal |

	gcTimes := Smalltalk vmParameterAt: self gcParameter.
	effectiveBatches := 0.
	total := 0.

	[ effectiveBatches < timesToIterate ] whileTrue: [
		gcTimes := aBlock value: gcTimes.
		batchOk := true.
		batchTotal := 0.

		(1 to: picEntries) do: [:picEntry |
			receiver := receivers at: picEntry.

			took := self calculateTookTime: aMethod.

			(gcTimes = (Smalltalk vmParameterAt: self gcParameter)) ifTrue: [
				batchTotal := batchTotal + took.
			] ifFalse: [
				StdIOWriteStream
					stderr
					nextPutAll: 'On: ', flow, ' original gcTimes !!= current gcTimes';
					newLine.

				batchOk := false.
				gcMatched := false.
				self gcCollect.
				gcTimes := Smalltalk vmParameterAt: self gcParameter.	
			]
		].

		batchOk ifTrue: [
			total := total + batchTotal.
			effectiveBatches := effectiveBatches + 1
		].
	].

	^total! !
!PerformanceTest class methodsFor: 'initialization' stamp: 'NMS 10/31/2025 03:03:27'!
                       getTestCaseReceivers

	| receivers arr oc str heap interv set |

	oc := OrderedCollection new.
	arr := Array new: 100.
	str := ''.
	heap := Heap new.
	interv := 1 to: 100.
	set := Set new.

	"Just add some values in order to get more content in size"
	(1 to: 100) do: [ :i |
		oc add: i.
		arr at: i put: i asString.
		str := str, i asString.
		heap add: i asString.
		set add: i asString.
	].

	"Now receivers could be 6, all entries of a PIC"
	receivers := OrderedCollection with: oc with: arr with: str with: heap with: interv with: set.

	"Now livetyping knows which type is each"
	receivers do: [ :aColl |
		receiver := aColl.
	].

	^ receivers! !
!PerformanceTest class methodsFor: 'initialization' stamp: 'NMS 2/13/2026 18:00:53'!
                              initializeWithPicEntries: aPicEntries stresMethod: aStressedMethod iterate: aTimesToIterate gcTimes: aGcDesiredTimesToRun saveItAsIterationName: aRunName withMeasureUnit: aMeasureUnit

	picEntries := aPicEntries.
	stressedMethod := aStressedMethod.
	timesToIterate := aTimesToIterate.
	gcDesiredTimesToRun := aGcDesiredTimesToRun.
	runName := aRunName.
	gcMatched := true.
	measureUnit := aMeasureUnit.! !

