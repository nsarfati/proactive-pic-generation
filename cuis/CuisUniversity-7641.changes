!SearchBrowser methodsFor: 'as yet unclassified' stamp: 'MM 6/4/2024 10:51:10'!
   initialize

	super initialize.
	
	searchString := ''.
	caseSensitive := false.
	messageList := Array new.
	domain := SystemSearchContext new.
	matcher := self matcherNames first.
	source := self sourceNames first.! !
