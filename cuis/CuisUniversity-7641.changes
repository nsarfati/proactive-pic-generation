	lines := ('depth/itervalues/depthtest6.txt' asFileEntry fileContents) lines.

	iter1 := (lines at: 1) asNumber.
	iter2 := (lines at: 2) asNumber.
	iter3 := (lines at: 3) asNumber.

	receiver := 1 to: 100.! !
