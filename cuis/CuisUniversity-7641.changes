!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/13/2026 17:55:30' prior: 50603719!
                     measureWithNormalFlowCurrentBehaviour

	| receivers compiledMethod |

	receivers := self getTestCaseReceivers.
	compiledMethod := self class >> stressedMethod asSymbol.
	(compiledMethod methodClass) recompile: (compiledMethod selector).

	self gcCollect.

	^ self runAndMeasure: compiledMethod in: 'measureWithNormalFlowCurrentBehaviour' forReceivers: receivers executeInEach: [:gcTimes | gcTimes].! !
!PerformanceTest class methodsFor: 'results' stamp: 'NMS 2/24/2026 14:44:19' prior: 50605630!
                runTestWriteResultsTo: aCSVFile for: aBlock

	| fileName resultsFileEntry vmStatsFileEntryBefore vmStatsFileEntryAfter line time |

	fileName := (aCSVFile findTokens: '.') at: 1.

	resultsFileEntry := aCSVFile asFileEntry.
	vmStatsFileEntryBefore := (fileName , '_vmstats_before_execution.csv') asFileEntry.
	vmStatsFileEntryAfter := (fileName , '_vmstats_after_execution.csv') asFileEntry.

	"Before execution"
	self storeMaxVMStats.
	vmStatsFileEntryBefore appendContents: (self getVMStatsLine).

	time := aBlock value.

	line := stressedMethod, ',', picEntries asString, ',', time asString, String lfString.
	resultsFileEntry appendContents: line.

	vmStatsFileEntryAfter appendContents: (self getVMStatsLine).! !
!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/24/2026 14:29:23'!
     storeMaxVMStats
	| vmParams primitiveUsedSpaceParams picUsedSpace |

	vmParams := #(2 9 10 11 19 21 22 46 62 64).
	primitiveUsedSpaceParams := Dictionary newFrom: {
		'primitive-jit-bytes' -> 1.
		'primitive-jit-count' -> 2.
		'primitive-pic-bytes' -> 3.
		'primitive-pic-count' -> 4.
	}.

	picUsedSpace := PICManager getUsedSpace.

	vmParams do: [ :i |
		maxVMStats at: i ifAbsentPut: (Smalltalk vmParameterAt: i).
		maxVMStats at: i put: ((maxVMStats at: i) max: (Smalltalk vmParameterAt: i)).
	].

	primitiveUsedSpaceParams keysAndValuesDo: [ :key :value |
		maxVMStats at: key ifAbsentPut: (picUsedSpace at: value).
		maxVMStats at: key put: ((maxVMStats at: key) max: (picUsedSpace at: value)).
	].! !
