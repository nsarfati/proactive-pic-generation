!PerformanceTest class methodsFor: 'measure - runner' stamp: 'NMS 2/13/2026 17:49:56'!
   runPerformanceTestJIT

	"runName := size/run$i"
	"runName := includes/run$i"
	"runName := seventh/run$i"

	self runTestWriteResultsTo: runName, '/results_jit_flow.csv' for: [
		self measureWithJIT
	].

	gcMatched ifTrue: [
		Smalltalk quitPrimitive: 0.
	] ifFalse: [
		Smalltalk quitPrimitive: 1.
	]! !
!PerformanceTest class methodsFor: 'measure - runner' stamp: 'NMS 2/13/2026 18:44:49'!
                          runPerformanceTestNormalFlowCurrentBehaviour 

	"runName := size/run$i"
	"runName := includes/run$i"
	"runName := seventh/run$i"

	self runTestWriteResultsTo: runName, '/results_normal_flow_current_behaviour.csv' for: [
		self measureWithNormalFlowCurrentBehaviour
	].

	gcMatched ifTrue: [
		Smalltalk quitPrimitive: 0.
	] ifFalse: [
		Smalltalk quitPrimitive: 1.
	]! !
!PerformanceTest class methodsFor: 'measure - runner' stamp: 'NMS 2/13/2026 17:57:59'!
                      runPerformanceTestNormalFlowWorstCase

	"runName := size/run$i"
	"runName := includes/run$i"
	"runName := seventh/run$i"

	self runTestWriteResultsTo: runName, '/results_normal_flow_worst_case.csv' for: [
		self measureWithNormalFlowWorstCase
	].

	gcMatched ifTrue: [
		Smalltalk quitPrimitive: 0.
	] ifFalse: [
		Smalltalk quitPrimitive: 1.
	]! !
!PerformanceTest class methodsFor: 'measure - runner' stamp: 'NMS 2/13/2026 18:44:55'!
            runPerformanceTestPIC 

	"runName := size/run$i"
	"runName := includes/run$i"
	"runName := seventh/run$i"

	self runTestWriteResultsTo: runName, '/results_pic_flow.csv' for: [
		self measureWithPIC
	].

	gcMatched ifTrue: [
		Smalltalk quitPrimitive: 0.
	] ifFalse: [
		Smalltalk quitPrimitive: 1.
	]! !
!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/13/2026 17:44:23'!
  calculateTookTime: method
	measureUnit = 'msNoGc' ifTrue: [
		^[self executeMethod: method] millisecondsToRunWithoutGC.
	] ifFalse: [
		measureUnit = 'ms' ifTrue: [
			^[self executeMethod: method] millisecondsToRun.
		] ifFalse: [
			^[self executeMethod: method] microsecondsToRun.
		]
	]! !
!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/13/2026 17:18:28'!
            gcCollect
	gcDesiredTimesToRun timesRepeat: [
		Smalltalk garbageCollect
	]
! !
!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 1/10/2026 21:13:51'!
  gcParameter
	^ 9! !
!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/28/2026 01:10:57'!
                              measureWithJIT

	| receivers compiledMethod |

	receivers := self getTestCaseReceivers.
	compiledMethod := self class >> stressedMethod asSymbol.
	(compiledMethod methodClass) recompile: (compiledMethod selector).

	self gcCollect.
	self updateMaxVMStats: initializationVMStats.
	PICManager jit: compiledMethod withSelector: compiledMethod selector.

	^ self runAndMeasure: compiledMethod in: 'measureWithJITFlow' forReceivers: receivers executeInEach: [:gcTimes | gcTimes].! !
!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/28/2026 01:11:02'!
                    measureWithNormalFlowCurrentBehaviour

	| receivers compiledMethod |

	receivers := self getTestCaseReceivers.
	compiledMethod := self class >> stressedMethod asSymbol.
	(compiledMethod methodClass) recompile: (compiledMethod selector).

	self gcCollect.
	self updateMaxVMStats: initializationVMStats.
	^ self runAndMeasure: compiledMethod in: 'measureWithNormalFlowCurrentBehaviour' forReceivers: receivers executeInEach: [:gcTimes | gcTimes].! !
!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/28/2026 01:11:13'!
                  measureWithNormalFlowWorstCase

	| receivers compiledMethod |

	receivers := self getTestCaseReceivers.
	compiledMethod := self class >> stressedMethod asSymbol.

	self gcCollect.
	self updateMaxVMStats: initializationVMStats.
	^ self runAndMeasure: compiledMethod in: 'measureWithNormalFlowWorstCase' forReceivers: receivers executeInEach: [:gcTimes |

		(compiledMethod methodClass) recompile: (compiledMethod selector).
		Smalltalk vmParameterAt: self gcParameter.
	].! !
!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/28/2026 01:11:53'!
                       measureWithPIC

	| receivers compiledMethod |

	receivers := self getTestCaseReceivers.
	compiledMethod := self class >> stressedMethod asSymbol.
	(compiledMethod methodClass) recompile: (compiledMethod selector).

	self gcCollect.
	self updateMaxVMStats: initializationVMStats.
	PICManager generatePICFor: compiledMethod.

	^ self runAndMeasure: compiledMethod in: 'measureWithPIC' forReceivers: receivers executeInEach: [:gcTimes | gcTimes].! !
!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/28/2026 01:09:36'!
                   runAndMeasure: aMethod in: flow forReceivers: receivers executeInEach: aBlock 

	| gcTimes effectiveBatches batchOk total took batchTotal |

	gcTimes := Smalltalk vmParameterAt: self gcParameter.
	effectiveBatches := 0.
	total := 0.

	[ effectiveBatches < timesToIterate ] whileTrue: [
		gcTimes := aBlock value: gcTimes.
		batchOk := true.
		batchTotal := 0.

		(1 to: 6) do: [:picEntry |
			receiver := receivers at: picEntry.

			took := self calculateTookTime: aMethod.

			(gcTimes = (Smalltalk vmParameterAt: self gcParameter)) ifTrue: [
				batchTotal := batchTotal + took.
				self updateMaxVMStats: maxVMStats.
			] ifFalse: [
				StdIOWriteStream
					stderr
					nextPutAll: 'On: ', flow, ' original gcTimes !!= current gcTimes';
					newLine.

				batchOk := false.
				gcMatched := false.
				self gcCollect.
				gcTimes := Smalltalk vmParameterAt: self gcParameter.	
			]
		].

		batchOk ifTrue: [
			total := total + batchTotal.
			effectiveBatches := effectiveBatches + 1
		].
	].

	^total! !
!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/28/2026 01:09:14'!
 updateMaxVMStats: maxStats

	| current picAndJitUsedSpace |

	current := Smalltalk vmParameterAt: 1. maxStats at: 1 put: ((maxStats at: 1) max: current).
	current := Smalltalk vmParameterAt: 2. maxStats at: 2 put: ((maxStats at: 2) max: current).
	current := Smalltalk vmParameterAt: 3. maxStats at: 3 put: ((maxStats at: 3) max: current).
