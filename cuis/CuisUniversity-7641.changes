!DepthPICBenchmark class methodsFor: 'initialization' stamp: 'NMS 2/27/2026 20:57:17'!
initializeWithPicEntries: aPicEntries stressMethod: aStressedMethod iterate: aTimesToIterate saveItAsIterationName: aRunName

	picEntries := aPicEntries.
	stressedMethod := aStressedMethod.
	timesToIterate := aTimesToIterate.
	runName := aRunName.
	gcMatched := true.

	sender := DTSender new.

	targets := {
		DTLeaf1 new.
		DTLeaf2 new.
		DTLeaf3 new.
		DTLeaf4 new.
		DTLeaf5 new.
		DTLeaf6 new
	}.

	"Now livetyping knows which type is each -- until picEntries"
	(1 to: picEntries) do: [ :i |
		sender receiver: (targets at: i)
	].

	rng := Random seed: 666.
	initializationVMStats := self getVMStatsComparedWith: (Dictionary new).
	maxVMStats := self getVMStatsComparedWith: (Dictionary new).! !

