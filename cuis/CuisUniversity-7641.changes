pickTransformation
	| r |
	r := Random next.
	
	r <= p1 ifTrue: [ ^t1 ].
	r := r - p1.
	
	r <= p2 ifTrue: [ ^t2 ].
	r := r - p2.
	
	r <= p3 ifTrue: [ ^t3 ].
	r := r - p3.
	
	r <= p4 ifTrue: [ ^t4 ].
	r := r - p4.
	
	self error: [ 'Probabilities do not add up to 1.0' ].!

