	self assert: (Character utf8BytesOf: 16r00A2) hex =  'C2A2'.
	self assert: (Character utf8BytesOf: 16r20AC) hex = 'E282AC'.
	self assert: (Character utf8BytesOf: 16r024B62) hex = 'F0A4ADA2'! !
