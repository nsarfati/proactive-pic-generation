!LayoutAdjustingMorph methodsFor: 'accessing' stamp: 'jmv 6/30/2025 11:54:30' prior: 16896157!
       cursor
	^ layoutSpec fixedWidth = Theme current layoutAdjusterThickness
		ifTrue: [ Cursor cursorAt: #resizeLeftCursor ]
