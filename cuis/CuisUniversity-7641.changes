!PerformanceTest class methodsFor: 'results' stamp: 'NMS 2/24/2026 14:45:31'!
                         getVMStatsLine
	| csvHeaderOrder line |
	
	csvHeaderOrder := #('primitive-jit-bytes' 'primitive-jit-count' 'primitive-pic-bytes' 'primitive-pic-count' 2 9 10 11 19 21 22 46 62 64).
	line := stressedMethod, ',', picEntries asString.

	csvHeaderOrder do: [ :h |
		line := line, ',', (maxVMStats at: h) asString.
	].

	line := line, String lfString.
	^line.! !
!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/13/2026 17:44:23' prior: 50603679!
                            calculateTookTime: method
	measureUnit = 'msNoGc' ifTrue: [
		^[self executeMethod: method] millisecondsToRunWithoutGC.
	] ifFalse: [
		measureUnit = 'ms' ifTrue: [
			^[self executeMethod: method] millisecondsToRun.
		] ifFalse: [
			^[self executeMethod: method] microsecondsToRun.
		]
	]! !
