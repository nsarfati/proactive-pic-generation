	| methodClass |

	methodClass := aMethodNode methodClass.
	aMethodNode accept: (
		ParseNodeEnumerator ofBlock: [:aNode | (self isNode: aNode anAssignmentToAClassVarFrom: methodClass) ifTrue: [^true]]).

