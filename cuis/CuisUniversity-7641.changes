		equals: (self tenPesos + self tenDollars) ^ 2.
		
	self 
		assert: (self tenPesos + self tenDollars) * (self tenPesos + self tenDollars) * (self tenPesos + self tenDollars)
		equals: (self tenPesos + self tenDollars) ^ 3.! !
