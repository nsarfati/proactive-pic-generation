                         testStringAsNumber2
	"Check that small but normal Floats can be created from Strings"

	| aFloat |
	aFloat _ '12345678901234567890.0e-326' asNumber.
	self deny: aFloat = 0.0.
	self assert: aFloat > 0.0.
	self assert: aFloat - 1.2345678901234568e-307 = 0.
