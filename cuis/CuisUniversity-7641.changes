!DepthPICBenchmark class methodsFor: 'initialization' stamp: 'NMS 2/18/2026 18:19:17'!
                initializeWithPicEntries: aPicEntries iterate: aTimesToIterate saveItAsIterationName: aRunName

	picEntries := aPicEntries.
	timesToIterate := aTimesToIterate.
	runName := aRunName.
	gcMatched := true.

	sender := DTSender new.

	targets := {
		DTLeaf1 new.
		DTLeaf2 new.
		DTLeaf3 new.
		DTLeaf4 new.
		DTLeaf5 new.
		DTLeaf6 new
	}.

	"Now livetyping knows which type is each -- until picEntries"
	(1 to: picEntries) do: [ :i |
		sender receiver: (targets at: i)
	].

	rng := Random seed: 666.! !
