		initializeVariablesRawTypesWhenMethodHasNoVariables;
		disableLiveTypingForReturnTypes ! !
!AdditionalMethodState methodsFor: '*LiveTyping' stamp: 'HAW 4/24/2023 12:48:23'!
                        disableLiveTypingForReturnTypes

	returnRawTypes := nil ! !
