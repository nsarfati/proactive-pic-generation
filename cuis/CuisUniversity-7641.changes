!Transcript class methodsFor: 'displaying' stamp: 'jmv 6/27/2025 10:44:05' prior: 50335314!
               display
	"See
		#display
		#displayUnfinishedEntry
		#displayEngine"
	showOnDisplay ifTrue: [
