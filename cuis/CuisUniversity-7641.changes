  initialize
	"Rebuild the hash table"
	"
	Symbol initialize.
	"
	self accessProtect critical:
		[
			Symbols := WeakSet new.
			CharacterSequence allSubclassesDo: [ :cls |
				cls representsSymbols ifTrue: [
					cls allInstancesDo: [ :sym | Symbols add: sym ]]]].! !

