!DepthPICBenchmark class methodsFor: 'measure' stamp: 'NMS 2/21/2026 17:53:05' prior: 50605193!
 measureWithPIC

	| compiledMethod |

	compiledMethod := sender class >> stressedMethod asSymbol.
	(compiledMethod methodClass) recompile: (compiledMethod selector).

	self gcCollect.
	PICManager generatePICFor: compiledMethod.

	^ self runAndMeasure: compiledMethod in: 'measureWithPIC' executeInEach: [:gcTimes | gcTimes].! !
!DepthPICBenchmark class methodsFor: 'measure' stamp: 'NMS 2/24/2026 14:49:51'!
         storeMaxVMStats
	| vmParams primitiveUsedSpaceParams picUsedSpace |

	vmParams := #(2 9 10 11 19 21 22 46 62 64).
	primitiveUsedSpaceParams := Dictionary newFrom: {
		'primitive-jit-bytes' -> 1.
		'primitive-jit-count' -> 2.
		'primitive-pic-bytes' -> 3.
		'primitive-pic-count' -> 4.
	}.

	picUsedSpace := PICManager getUsedSpace.

	vmParams do: [ :i |
		maxVMStats at: i ifAbsentPut: (Smalltalk vmParameterAt: i).
		maxVMStats at: i put: ((maxVMStats at: i) max: (Smalltalk vmParameterAt: i)).
	].

	primitiveUsedSpaceParams keysAndValuesDo: [ :key :value |
		maxVMStats at: key ifAbsentPut: (picUsedSpace at: value).
		maxVMStats at: key put: ((maxVMStats at: key) max: (picUsedSpace at: value)).
	].! !
!DepthPICBenchmark class methodsFor: 'measure - runner' stamp: 'NMS 2/19/2026 13:04:36' prior: 50605080!
                    runPerformanceTestJIT

	self runTestWriteResultsTo: runName, '/results_jit_flow.csv' for: [
		self measureWithJIT
	].

	gcMatched ifTrue: [
		Smalltalk quitPrimitive: 0.
	] ifFalse: [
		Smalltalk quitPrimitive: 1.
	]! !
