	| instVarName typeInfo |

	instVarName := (self wordAt: mousePositionInText) asString.
	typeInfo := self codeProvider selectedClass typeInfoOfInstanceVariableNamed: instVarName ifAbsent: [^''].

	^typeInfo printTypesUpTo: 5! !
