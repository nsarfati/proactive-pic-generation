			newLine;
			nextPutAll: 'This action cannot be undone.';
			newLine;
			newLine;
			nextPutAll: 'Do you want to continue?'
		]! !
!ChangeSorter methodsFor: 'changeSet menu' stamp: 'NPM 6/9/2025 09:28:00' prior: 16809899!
              trimHistory
