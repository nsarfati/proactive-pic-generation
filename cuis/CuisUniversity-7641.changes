	^ByteArray new: 4		"0.0.0.0"! !
!Socket class methodsFor: 'utilities' stamp: 'ar 4/30/1999 04:21'!
                  wildcardPort
	"Answer a don't-care port for use with UDP sockets.  (The system will allocate an
	unused port number to the socket.)"

