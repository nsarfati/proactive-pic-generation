          gcParameter
	^9! !
!DepthTest class methodsFor: 'measure' stamp: 'NMS 10/31/2025 11:38:41'!
    getTestCaseReceivers

	| receivers arr oc str heap interv set |

	oc := OrderedCollection new.
	arr := Array new: 100.
	str := ''.
	heap := Heap new.
	interv := 1 to: 100.
	set := Set new.

	"Just add some values in order to get more content in size"
	(1 to: 100) do: [ :i |
		oc add: i.
		arr at: i put: i asString.
		str := str, i asString.
		heap add: i asString.
		set add: i asString.
	].

	"Now receivers could be 6, all entries of a PIC"
	receivers := OrderedCollection with: oc with: arr with: str with: heap with: interv with: set.

	"Now livetyping knows which type is each"
	receivers do: [ :aColl |
		receiver := aColl.
	].

	^ receivers! !
!DepthTest class methodsFor: 'measure' stamp: 'NMS 10/31/2025 14:03:11'!
          getTestCaseReceivers2

	| receivers2 |

	"Now receivers could be 6, all entries of a PIC"
	receivers2 := OrderedCollection with: DepthTest with: DepthTest2 with: DepthTest3 with: DepthTest4 with: DepthTest5 with: DepthTest6.

	"Now livetyping knows which type is each"
	receivers2 do: [ :aColl |
		receiver2 := aColl.
	].

	^ receivers2! !
!DepthTest class methodsFor: 'measure' stamp: 'NMS 2/10/2026 21:31:48'!
    measureWithJITFlow

	| receivers total receivers2 gcTimes took effectiveTimes |

	receivers := self getTestCaseReceivers.
	receivers2 := self getTestCaseReceivers2.

	effectiveTimes := 0.
	total := 0.

	receivers2 do: [ :r |
		r class recompile: #d4.
		r class recompile: #d3.
		r class recompile: #d2.
	].

	self class recompile: #d4.
	self class recompile: #d3.
	self class recompile: #d2.
	self class recompile: #d1.

	self collect.

	PICManager jit: DepthTest class>>#d1 withSelector: #d1.
	PICManager jit: DepthTest class>>#d2 withSelector: #d2.
	PICManager jit: DepthTest class>>#d3 withSelector: #d3.
	PICManager jit: DepthTest class>>#d4 withSelector: #d4.

	PICManager jit: DepthTest2 class>>#d2 withSelector: #d2.
	PICManager jit: DepthTest2 class>>#d3 withSelector: #d3.
	PICManager jit: DepthTest2 class>>#d4 withSelector: #d4.

	PICManager jit: DepthTest3 class>>#d2 withSelector: #d2.
	PICManager jit: DepthTest3 class>>#d3 withSelector: #d3.
	PICManager jit: DepthTest3 class>>#d4 withSelector: #d4.

	PICManager jit: DepthTest4 class>>#d2 withSelector: #d2.
	PICManager jit: DepthTest4 class>>#d3 withSelector: #d3.
	PICManager jit: DepthTest4 class>>#d4 withSelector: #d4.

	PICManager jit: DepthTest5 class>>#d2 withSelector: #d2.
	PICManager jit: DepthTest5 class>>#d3 withSelector: #d3.
	PICManager jit: DepthTest5 class>>#d4 withSelector: #d4.

	PICManager jit: DepthTest6 class>>#d2 withSelector: #d2.
	PICManager jit: DepthTest6 class>>#d3 withSelector: #d3.
	PICManager jit: DepthTest6 class>>#d4 withSelector: #d4.

	gcTimes := Smalltalk vmParameterAt: self gcParameter.

	timesToIterate timesRepeat: [
		(1 to: picEntries) do: [:picEntry |
			receiver := receivers at: picEntry.
			receiver2 := receivers2 at: picEntry.

			took := self calculateTookTime.

			(gcTimes = (Smalltalk vmParameterAt: self gcParameter)) ifTrue: [
				total := total + took.
				effectiveTimes := effectiveTimes + 1.
			] ifFalse: [
				StdIOWriteStream
					stderr
					nextPutAll: 'On measureWithJITFlow original gcTimes !!= current gcTimes';
					newLine.
				"self halt."
				gcMatched := false.
				self collect.
				gcTimes := Smalltalk vmParameterAt: self gcParameter.	
			]
		]
	].

	^(total / effectiveTimes) asFloat.! !
