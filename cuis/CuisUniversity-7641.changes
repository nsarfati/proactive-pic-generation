!Symbol methodsFor: 'comparing' library: #MinimalKernel01 stamp: 'jmv 6/3/2022 10:34:38' prior: 16969812!
 = another

	"Use == between two symbols..."
	self == another ifTrue: [
		^ true].  "Was == "
	another isSymbol ifTrue: [
		^ false].  "Was not ==, therefore can't be = "

	"Otherwise use string =..."
	^ super = another! !
