	stressedMethod := aStressedMethod.
	timesToIterate := aTimesToIterate.
	gcDesiredTimesToRun := aGcDesiredTimesToRun.
	runName := aRunName.
	gcMatched := true.
	measureUnit := aMeasureUnit.! !

