!DepthPICBenchmark class methodsFor: 'measure' stamp: 'NMS 2/27/2026 20:57:31'!
  runAndMeasure: aCompiledMethod in: flow executeInEach: aBlock

	| gcTimes effectiveBatches batchOk total took batchTotal |

	gcTimes := Smalltalk vmParameterAt: (PerformanceTest gcParameter).
	effectiveBatches := 0.
	total := 0.

	[ effectiveBatches < timesToIterate ] whileTrue: [
		| idx |

		gcTimes := aBlock value: gcTimes.
		batchOk := true.
		batchTotal := 0.

		idx := self nextIndexUpTo: 6.
		sender receiver: (targets at: idx).

		took := self calculateTookTime: aCompiledMethod .

		(gcTimes = (Smalltalk vmParameterAt: (PerformanceTest gcParameter))) ifTrue: [
			batchTotal := batchTotal + took.
		] ifFalse: [
			StdIOWriteStream
				stderr
				nextPutAll: 'On: ', flow, ' original gcTimes !!= current gcTimes';
				newLine.

			batchOk := false.
			gcMatched := false.
			self gcCollect.
			gcTimes := Smalltalk vmParameterAt: (PerformanceTest gcParameter).	
		].

		batchOk ifTrue: [
			maxVMStats := self getVMStatsComparedWith: maxVMStats.
			total := total + batchTotal.
			effectiveBatches := effectiveBatches + 1
		].
	].

	^total! !
!DepthPICBenchmark class methodsFor: 'measure' stamp: 'NMS 2/27/2026 20:54:28'!
                 getVMStatsComparedWith: aVMStatsToCompareWith

	| vmStats vmParams primitiveUsedSpaceParams picUsedSpace |

	vmStats := Dictionary new.
	vmParams := #(2 9 10 11 19 21 22 46 62 64).
	primitiveUsedSpaceParams := Dictionary newFrom: {
		'primitive-jit-bytes' -> 1.
		'primitive-jit-count' -> 2.
		'primitive-pic-bytes' -> 3.
		'primitive-pic-count' -> 4.
	}.

	picUsedSpace := PICManager getUsedSpace.

	vmParams do: [ :i |
		aVMStatsToCompareWith at: i ifAbsentPut: (Smalltalk vmParameterAt: i).
		vmStats at: i put: ((aVMStatsToCompareWith at: i) max: (Smalltalk vmParameterAt: i)).
	].

	primitiveUsedSpaceParams keysAndValuesDo: [ :key :value |
		aVMStatsToCompareWith at: key ifAbsentPut: (picUsedSpace at: value).
		vmStats at: key put: ((aVMStatsToCompareWith at: key) max: (picUsedSpace at: value)).
	].

	^vmStats.! !
