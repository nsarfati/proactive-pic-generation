!MinusInfinity methodsFor: 'arithmetic operations' stamp: ''!
       * aMeasure

	aMeasure isNothing
		ifTrue: [self signalIndeterminateOperation: 'Multiplication' leftOperand: aMeasure].
	^aMeasure multiplyMinusInfinity: self! !
