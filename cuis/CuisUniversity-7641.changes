!DepthTest class methodsFor: 'measure' stamp: 'NMS 2/10/2026 21:24:50'!
 runPerformanceTestForDepth
"
	| now |

	timesToIterate := 1.
	gcDesiredTimesToRun := 1.

	DepthTest2 initialize.
	DepthTest3 initialize.
	DepthTest4 initialize.
	DepthTest5 initialize.
	DepthTest6 initialize.

	now := '.'."(Date today yyyymmdd asString), '-', (DateAndTime now - (DateAndTime year: 1970 month: 1 day: 1)) totalSeconds asString."

	self runTestWriteResultsTo: 'depth/', now, '/results_normal_flow_current_behaviour.csv' for: [ :picEntry |
		self measureWithNormalFlowCurrentBehaviour: picEntry
	].

	self runTestWriteResultsTo: 'depth/', now, '/results_pic_flow.csv' for: [ :picEntry |
		self measureWithPIC: picEntry
	].

	self runTestWriteResultsTo: 'depth/', now, '/results_jit_flow.csv' for: [ :picEntry |
		self measureWithJITFlow: picEntry
	].

	self runTestWriteResultsTo: 'depth/', now, '/results_normal_flow_worst_case.csv' for: [ :picEntry |
		self measureWithNormalFlowWorstCase: picEntry
	].
"! !
!DepthTest class methodsFor: 'measure' stamp: 'NMS 2/11/2026 12:35:50'!
                            runTestWriteResultsTo: aCSVFile for: aBlock

	| picFlow line time |

	picFlow := aCSVFile asFileEntry.
	time := aBlock value.

"
	time := ((1 to: 100) collect: [ :i |
		aBlock value.
	]) average.
"

	line := 'd1', ',', picEntries asString, ',', time asString, String lfString.
	picFlow appendContents: line.
! !
!DepthTest class methodsFor: 'initialization' stamp: 'NMS 2/12/2026 12:39:10'!
                         initializeWithPicEntries: aPicEntries iterate: aTimesToIterate gcTimes: aGcDesiredTimesToRun saveItAsIterationName: aRunName withMeasureUnit: aMeasureUnit andSetSize: aSetSize  

	| lines |

	picEntries := aPicEntries.
	timesToIterate := aTimesToIterate.
	gcDesiredTimesToRun := aGcDesiredTimesToRun.
	runName := aRunName.
	gcMatched := true.
	measureUnit := aMeasureUnit.
	setSize := aSetSize.

	lines := self readLinesForTestFile: 'depthtest.txt'.

	iter1 := (lines at: 1) asNumber.
	iter2 := (lines at: 2) asNumber.
	iter3 := (lines at: 3) asNumber.
	iter4 := (lines at: 4) asNumber.
! !
!DepthTest class methodsFor: 'initialization' stamp: 'NMS 2/12/2026 12:39:10'!
  readLinesForTestFile: aTestFile
	^(Smalltalk imagePath, '/performance-parameters/depth/', setSize, '/', aTestFile) asFileEntry fileContents lines! !
