!DepthTest class methodsFor: 'measure - helper' stamp: 'NMS 2/12/2026 17:29:59'!
       runAndMeasure: flow forReceiver1: receivers andReceivers2: receivers2 executeInEach: aBlock 

	| gcTimes effectiveBatches batchOk total took batchTotal |

	gcTimes := Smalltalk vmParameterAt: self gcParameter.
	effectiveBatches := 0.
	total := 0.

	[ effectiveBatches < timesToIterate ] whileTrue: [
		gcTimes := aBlock value: gcTimes.
		batchOk := true.
		batchTotal := 0.

		(1 to: picEntries) do: [:picEntry |
			receiver := receivers at: picEntry.
			receiver2 := receivers2 at: picEntry.

			took := self calculateTookTime.

			(gcTimes = (Smalltalk vmParameterAt: self gcParameter)) ifTrue: [
				batchTotal := batchTotal + took.
			] ifFalse: [
				StdIOWriteStream
					stderr
					nextPutAll: 'On: ', flow, ' original gcTimes !!= current gcTimes';
					newLine.

				batchOk := false.
				gcMatched := false.
				self collect.
				gcTimes := Smalltalk vmParameterAt: self gcParameter.	
			]
		].

		batchOk ifTrue: [
			total := total + batchTotal.
			effectiveBatches := effectiveBatches + 1
		].
	].

	^total "asFloat??"! !
!DepthTest class methodsFor: 'measure' stamp: 'NMS 2/10/2026 18:59:48'!
             calculateTookTime
	measureUnit = 'msNoGc' ifTrue: [
		^[self d1] millisecondsToRunWithoutGC.
	] ifFalse: [
		measureUnit = 'ms' ifTrue: [
