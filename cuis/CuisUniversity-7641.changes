         performSearch

	| innerTextMorph |
	
	innerTextMorph := searchStringInput submorphsSatisfying: [:m | m isKindOf: InnerTextMorph ] :: first.
	innerTextMorph hasUnacceptedEdits 
		ifFalse: [self model performSearch]
		ifTrue: [innerTextMorph acceptContents].! !
