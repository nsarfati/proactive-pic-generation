                          buildMorphicClassList

	^(PluggableListMorph
		withModel: model
		listGetter: #classList
		indexGetter: #classListIndex
		indexSetter: #classListIndex:)
			menuNshortcutsKey: #denotativeObjectClassListMenuSpec;
			doubleClickSelector: #browseMethodFull.! !
