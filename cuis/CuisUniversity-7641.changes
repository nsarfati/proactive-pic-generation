                            measureWithNormalFlowWorstCase

	| receivers compiledMethod |

	receivers := self getTestCaseReceivers.
	compiledMethod := self class >> stressedMethod asSymbol.

	self gcCollect.

	^ self runAndMeasure: compiledMethod in: 'measureWithNormalFlowWorstCase' forReceivers: receivers executeInEach: [:gcTimes |

		(compiledMethod methodClass) recompile: (compiledMethod selector).
		Smalltalk vmParameterAt: self gcParameter.
