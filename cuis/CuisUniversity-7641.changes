	self class recompile: #d2.
	self class recompile: #d1.

	self collect.

	self picD1.
	self picD2.
	self picD3.
	self picD4.

	self generatePICForDepthTest2.
	self generatePICForDepthTest3.
	self generatePICForDepthTest4.
	self generatePICForDepthTest5.
	self generatePICForDepthTest6.

	gcTimes := Smalltalk vmParameterAt: self gcParameter.

