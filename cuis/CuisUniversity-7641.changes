Aconcagua initialize!
!Integer methodsFor: 'as yet unclassified' library: #MinimalKernel01 stamp: 'Install-Aconcagua 10/7/2025 10:00:06' prior: 50368915!
                      = aNumber

	"Any object is equal to itself"
	self == aNumber ifTrue: [ ^ true ].

	aNumber isNumber 
		ifTrue: [
			aNumber isInteger ifTrue: [
				aNumber class == self class ifFalse: [ ^false ].
				^ (self digitCompare: aNumber) = 0] ]
		 ifFalse: [
			(aNumber isKindOf: Measure) ifFalse: [ ^ false ]].
		
	^ aNumber adaptToInteger: self andSend: #=! !

CompoundUnit initialize!

NullUnit initialize!

