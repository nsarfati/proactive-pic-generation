                  isKeyDown
	^ keyEventType == #keyDown! !
!KeyboardEvent methodsFor: 'testing' stamp: 'jmv 9/3/2025 16:23:53' prior: 16894778!
  isKeyUp
	^ keyEventType == #keyUp! !
!KeyboardEvent methodsFor: 'testing' stamp: 'jmv 9/3/2025 16:23:49' prior: 16894784!
      isKeystroke
	^ keyEventType == #keystroke! !
