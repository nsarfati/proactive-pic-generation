!classDefinition: #DepthPICBenchmark category: #'Tesis-DepthTest' stamp: 'NMS 2/21/2026 17:58:20'!
Object subclass: #DepthPICBenchmark
	instanceVariableNames: 'rng sender targets'
	classVariableNames: ''
	poolDictionaries: ''
	category: 'Tesis-DepthTest'!

"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!

DepthPICBenchmark class
	instanceVariableNames: 'rng sender runName picEntries stressedMethod timesToIterate gcMatched targets'!

!classDefinition: 'DepthPICBenchmark class' category: #'Tesis-DepthTest' stamp: 'NMS 2/21/2026 17:58:20'!
DepthPICBenchmark class
	instanceVariableNames: 'rng sender runName picEntries stressedMethod timesToIterate gcMatched targets'!
!DepthPICBenchmark class methodsFor: 'initialization' stamp: 'NMS 2/21/2026 17:48:57'!
                  initializeWithPicEntries: aPicEntries stressMethod: aStressedMethod iterate: aTimesToIterate saveItAsIterationName: aRunName

	picEntries := aPicEntries.
	stressedMethod := aStressedMethod.
	timesToIterate := aTimesToIterate.
	runName := aRunName.
	gcMatched := true.

	sender := DTSender new.

	targets := {
		DTLeaf1 new.
		DTLeaf2 new.
		DTLeaf3 new.
		DTLeaf4 new.
		DTLeaf5 new.
		DTLeaf6 new
	}.

	"Now livetyping knows which type is each -- until picEntries"
	(1 to: picEntries) do: [ :i |
		sender receiver: (targets at: i)
	].

	rng := Random seed: 666.! !
!DepthPICBenchmark class methodsFor: 'measure - runner' stamp: 'NMS 2/19/2026 13:04:36' prior: 50602772!
 runPerformanceTestJIT

	self runTestWriteResultsTo: runName, '/results_jit_flow.csv' for: [
		self measureWithJIT
	].

	gcMatched ifTrue: [
		Smalltalk quitPrimitive: 0.
	] ifFalse: [
		Smalltalk quitPrimitive: 1.
	]! !
!DepthPICBenchmark class methodsFor: 'measure - runner' stamp: 'NMS 2/18/2026 18:10:18' prior: 50602782!
                           runPerformanceTestNormalFlowCurrentBehaviour

	self runTestWriteResultsTo: runName, '/results_normal_flow_current_behaviour.csv' for: [
		self measureWithNormalFlowCurrentBehaviour
	].

	gcMatched ifTrue: [
		Smalltalk quitPrimitive: 0.
	] ifFalse: [
		Smalltalk quitPrimitive: 1.
	]! !
!DepthPICBenchmark class methodsFor: 'measure - runner' stamp: 'NMS 2/19/2026 13:04:59' prior: 50602794!
                        runPerformanceTestNormalFlowWorstCase

	self runTestWriteResultsTo: runName, '/results_normal_flow_worst_case.csv' for: [
		self measureWithNormalFlowWorstCase
	].

	gcMatched ifTrue: [
		Smalltalk quitPrimitive: 0.
	] ifFalse: [
		Smalltalk quitPrimitive: 1.
	]! !
!DepthPICBenchmark class methodsFor: 'measure - runner' stamp: 'NMS 2/18/2026 18:09:43' prior: 50602806!
             runPerformanceTestPIC 

	self runTestWriteResultsTo: runName, '/results_pic_flow.csv' for: [
		self measureWithPIC
	].

	gcMatched ifTrue: [
		Smalltalk quitPrimitive: 0.
	] ifFalse: [
		Smalltalk quitPrimitive: 1.
	]! !
!DepthPICBenchmark class methodsFor: 'measure - runner' stamp: 'NMS 2/18/2026 18:09:56' prior: 50602816!
                          runTestWriteResultsTo: aCSVFile for: aBlock

	| picFlow line time |

	picFlow := aCSVFile asFileEntry.
	time := aBlock value.

	line := 'depth', ',', picEntries asString, ',', time asString, String lfString.
	picFlow appendContents: line.! !
