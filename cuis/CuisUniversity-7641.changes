	notIncludedReceiverTypesInMessageSends := OrderedCollection new.

	implementors ifNotEmpty: [
		sentSelector := implementors anyOne selector.
		types := implementors collect: [ :anImplementor | anImplementor methodClass ].

		senders do: [ :aSender |
