!PerformanceTest class methodsFor: 'measure - runner' stamp: 'NMS 2/13/2026 17:49:56'!
runPerformanceTestJIT

	"runName := size/run$i"
	"runName := includes/run$i"
	"runName := seventh/run$i"

	self runTestWriteResultsTo: runName, '/results_jit_flow.csv' for: [
		self measureWithJIT
	].

	gcMatched ifTrue: [
		Smalltalk quitPrimitive: 0.
	] ifFalse: [
		Smalltalk quitPrimitive: 1.
	]! !

