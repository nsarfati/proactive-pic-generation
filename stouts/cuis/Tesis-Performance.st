!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/28/2026 01:41:23'!
runAndMeasure: aMethod in: flow forReceivers: receivers executeInEach: aBlock 

	| gcTimes effectiveBatches batchOk total took batchTotal |

	gcTimes := Smalltalk vmParameterAt: self gcParameter.
	effectiveBatches := 0.
	total := 0.

	[ effectiveBatches < timesToIterate ] whileTrue: [
		gcTimes := aBlock value: gcTimes.
		batchOk := true.
		batchTotal := 0.

		(1 to: 6) do: [:picEntry |
			receiver := receivers at: picEntry.

			took := self calculateTookTime: aMethod.

			(gcTimes = (Smalltalk vmParameterAt: self gcParameter)) ifTrue: [
				batchTotal := batchTotal + took.
				self updateMaxVMStats: maxVMStats.
			] ifFalse: [
				StdIOWriteStream
					stderr
					nextPutAll: 'On: ', flow, ' original gcTimes !!= current gcTimes';
					newLine.

				batchOk := false.
				gcMatched := false.
				gcTimes := Smalltalk vmParameterAt: self gcParameter.	
			]
		].

		batchOk ifTrue: [
			total := total + batchTotal.
			effectiveBatches := effectiveBatches + 1
		].
	].

	^total! !

