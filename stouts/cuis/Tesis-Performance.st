!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/13/2026 17:44:23'!
calculateTookTime: method
	measureUnit = 'msNoGc' ifTrue: [
		^[self executeMethod: method] millisecondsToRunWithoutGC.
	] ifFalse: [
		measureUnit = 'ms' ifTrue: [
			^[self executeMethod: method] millisecondsToRun.
		] ifFalse: [
			^[self executeMethod: method] microsecondsToRun.
		]
	]! !

!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 2/13/2026 17:18:28'!
gcCollect
	gcDesiredTimesToRun timesRepeat: [
		Smalltalk garbageCollect
	]
! !

!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 1/10/2026 21:13:51'!
gcParameter
	^ 9! !

!PerformanceTest class methodsFor: 'measure' stamp: 'NMS 6/11/2026 12:38:33'!
measureWithJIT

	| receivers compiledMethod |

	receivers := self getTestCaseReceivers.
	compiledMethod := self class >> stressedMethod asSymbol.
	(compiledMethod methodClass) recompile: (compiledMethod selector).

	self gcCollect.
	self updateMaxVMStats: initializationVMStats.
	ProactivePICBuilder jit: compiledMethod withSelector: compiledMethod selector.

	^ self runAndMeasure: compiledMethod in: 'measureWithJITFlow' forReceivers: receivers executeInEach: [:gcTimes | gcTimes].! !

