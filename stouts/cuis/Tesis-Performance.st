!PerformanceTest class methodsFor: 'results' stamp: 'NMS 2/28/2026 01:12:59'!
getVMStatsLine: vmStats
	| line |

	line := stressedMethod, ',', picEntries asString.

	vmStats do: [ :e |
		line := line, ',', e asString.
	].

	line := line, String lfString.
	^line.! !

!PerformanceTest class methodsFor: 'results' stamp: 'NMS 2/28/2026 01:13:22'!
runTestWriteResultsTo: aCSVFile for: aBlock

	| fileName resultsFileEntry vmStatsFileEntryBefore vmStatsFileEntryAfter line time |

	time := aBlock value.

	fileName := (aCSVFile findTokens: '.') at: 1.

	resultsFileEntry := aCSVFile asFileEntry.
	vmStatsFileEntryBefore := (fileName , '_vmstats_before_execution.csv') asFileEntry.
	vmStatsFileEntryAfter := (fileName , '_vmstats_after_execution.csv') asFileEntry.

	vmStatsFileEntryBefore appendContents: (self getVMStatsLine: initializationVMStats).

	line := stressedMethod, ',', picEntries asString, ',', time asString, String lfString.
	resultsFileEntry appendContents: line.

	vmStatsFileEntryAfter appendContents: (self getVMStatsLine: maxVMStats).! !


!PerformanceTest class methodsFor: 'initialization' stamp: 'NMS 2/19/2026 12:49:14'!
getTestCaseReceivers

	| receivers arr oc str heap interv set |

	oc := OrderedCollection new.
	arr := Array new: 100.
	str := ''.
	heap := Heap new.
	interv := 1 to: 100.
	set := Set new.

	"Just add some values in order to get more content in size"
	(1 to: 100) do: [ :i |
		oc add: i.
		arr at: i put: i asString.
		str := str, i asString.
		heap add: i asString.
		set add: i asString.
	].

	"Now receivers could be 6, all entries of a PIC"
	receivers := OrderedCollection with: oc with: arr with: str with: heap with: interv with: set.

	"Now livetyping knows which type is each"
	(1 to: picEntries) do: [ :i |
		receiver := receivers at: i.
	].

	^ receivers! !

!PerformanceTest class methodsFor: 'initialization' stamp: 'NMS 2/28/2026 01:10:16'!
initializeWithPicEntries: aPicEntries stresMethod: aStressedMethod iterate: aTimesToIterate gcTimes: aGcDesiredTimesToRun saveItAsIterationName: aRunName withMeasureUnit: aMeasureUnit

